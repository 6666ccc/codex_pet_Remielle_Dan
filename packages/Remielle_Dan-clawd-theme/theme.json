{
  "schemaVersion": 1,
  "name": "蕾米埃尔 · Clawd",
  "author": "刘畅",
  "version": "0.5.2",
  "description": "包含高帧状态、随机待机与入睡流程的 Clawd on Desk 主题。",
  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 120,
    "height": 120
  },
  "layout": {
    "contentBox": {
      "x": 8,
      "y": 5,
      "width": 104,
      "height": 110
    },
    "centerX": 60,
    "baselineY": 111,
    "visibleHeightRatio": 0.72,
    "baselineBottomRatio": 0.04
  },
  "eyeTracking": {
    "enabled": false,
    "states": []
  },
  "sleepSequence": {
    "mode": "full"
  },
  "states": {
    "idle": [
      "idle-loop.gif"
    ],
    "thinking": [
      "thinking.gif"
    ],
    "working": [
      "editing.gif"
    ],
    "roam": [
      "roam.gif"
    ],
    "yawning": [
      "sleeping.gif"
    ],
    "dozing": [
      "sleeping.gif"
    ],
    "collapsing": [
      "sleeping.gif"
    ],
    "attention": [
      "attention.gif"
    ],
    "notification": [
      "notification.gif"
    ],
    "carrying": [
      "carrying.gif"
    ],
    "error": [
      "error.gif"
    ],
    "sleeping": [
      "sleeping.gif"
    ],
    "waking": [
      "sleeping.gif"
    ]
  },
  "idleAnimations": [
    {
      "file": "idle-reading.gif",
      "duration": 10000
    }
  ],
  "reactions": {
    "drag": {
      "file": "roam.gif",
      "fileLeft": "drag-left.gif",
      "fileRight": "drag-right.gif"
    },
    "double": {
      "files": [
        "react-double.gif"
      ],
      "duration": 2800
    }
  },
  "timings": {
    "minDisplay": {
      "notification": 5000,
      "carrying": 3000
    },
    "autoReturn": {
      "notification": 5000,
      "carrying": 3000
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000,
    "yawnDuration": 1680,
    "wakeDuration": 1680
  },
  "displayHintMap": {
    "file-editing": "editing.gif"
  },
  "customization": {
    "petTint": false
  },
  "hitBoxes": {
    "default": {
      "x": 8,
      "y": 5,
      "w": 104,
      "h": 110
    },
    "sleeping": {
      "x": 8,
      "y": 5,
      "w": 104,
      "h": 110
    }
  },
  "sleepingHitboxFiles": [
    "sleeping.gif"
  ],
  "miniMode": {
    "supported": false
  }
}
