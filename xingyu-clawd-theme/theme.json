{
  "schemaVersion": 1,
  "name": "蕾米埃尔 · Clawd",
  "author": "刘畅",
  "version": "0.3.0",
  "description": "基于原始高帧 GIF 制作的独立 Clawd on Desk 主题。",
  "viewBox": { "x": 0, "y": 0, "width": 120, "height": 120 },
  "layout": {
    "contentBox": { "x": 8, "y": 5, "width": 104, "height": 110 },
    "centerX": 60,
    "baselineY": 111,
    "visibleHeightRatio": 0.72,
    "baselineBottomRatio": 0.04
  },
  "eyeTracking": {
    "enabled": false,
    "states": []
  },
  "sleepSequence": {
    "mode": "full"
  },
  "states": {
    "idle": ["idle-loop.gif"],
    "thinking": ["thinking.gif"],
    "working": ["editing.gif"],
    "roam": ["roam.gif"],
    "yawning": ["yawning.gif"],
    "dozing": ["dozing.gif"],
    "collapsing": ["collapsing.gif"],
    "attention": ["attention.gif"],
    "notification": ["notification.gif"],
    "error": ["error.gif"],
    "sleeping": ["sleeping.gif"],
    "waking": ["waking.gif"]
  },
  "reactions": {
    "drag": {
      "file": "roam.gif",
      "fileLeft": "drag-left.gif",
      "fileRight": "drag-right.gif"
    },
    "clickLeft": { "file": "click-left.gif", "duration": 2400 },
    "clickRight": { "file": "click-right.gif", "duration": 2400 },
    "annoyed": { "file": "react-annoyed.gif", "duration": 3000 },
    "double": { "files": ["react-double.gif"], "duration": 2800 }
  },
  "timings": {
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000,
    "yawnDuration": 1800,
    "wakeDuration": 1500
  },
  "displayHintMap": {
    "file-editing": "editing.gif"
  },
  "customization": {
    "petTint": false
  },
  "hitBoxes": {
    "default": { "x": 8, "y": 5, "w": 104, "h": 110 },
    "sleeping": { "x": 8, "y": 5, "w": 104, "h": 110 }
  },
  "sleepingHitboxFiles": ["sleeping.gif"],
  "miniMode": {
    "supported": false
  }
}
